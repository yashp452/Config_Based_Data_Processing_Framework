# Absolute path to the root of this repo on your machine
PROJECT_DIR=/absolute/path/to/config_based_data_processing

# MinIO (S3-compatible object storage) — defaults work with docker-compose
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=retail

# PostgreSQL (Gold layer sink) — defaults work with docker-compose
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gold
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
