{
  "dataset": "gold_sales_by_customer",
  "layer": "gold",
  "source": {
    "format": "delta",
    "path": "s3a://retail/silver/retail_orders_enriched/",
    "options": {}
  },
  "aggregation": {
    "group_by": ["customer_id", "segment", "region"],
    "metrics": [
      { "name": "total_spend",     "expr": "sum(total_amount)" },
      { "name": "order_count",     "expr": "count(order_id)" },
      { "name": "avg_order_value", "expr": "avg(total_amount)" }
    ]
  },
  "sink": {
    "format": "postgres",
    "schema": "gold_schema",
    "table": "gold_sales_by_customer",
    "mode": "overwrite"
  }
}
