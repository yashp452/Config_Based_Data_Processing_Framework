{
  "dataset": "gold_daily_trend",
  "layer": "gold",
  "source": {
    "format": "delta",
    "path": "s3a://retail/silver/retail_orders_enriched/",
    "options": {}
  },
  "aggregation": {
    "group_by": ["order_date"],
    "metrics": [
      { "name": "total_revenue",   "expr": "sum(total_amount)" },
      { "name": "order_count",     "expr": "count(order_id)" },
      { "name": "avg_order_value", "expr": "avg(total_amount)" }
    ]
  },
  "sink": {
    "format": "postgres",
    "schema": "gold_schema",
    "table": "gold_daily_trend",
    "mode": "overwrite"
  }
}
