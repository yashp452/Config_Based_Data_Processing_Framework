{
  "dataset": "gold_sales_by_store",
  "layer": "gold",
  "source": {
    "format": "delta",
    "path": "s3a://retail/silver/retail_orders_enriched/",
    "options": {}
  },
  "aggregation": {
    "group_by": ["store_id", "store_name", "store_type", "order_date"],
    "metrics": [
      { "name": "total_revenue",    "expr": "sum(total_amount)" },
      { "name": "order_count",      "expr": "count(order_id)" },
      { "name": "avg_order_value",  "expr": "avg(total_amount)" }
    ]
  },
  "sink": {
    "format": "postgres",
    "schema": "gold_schema",
    "table": "gold_sales_by_store",
    "mode": "overwrite"
  }
}
