FROM python:3.12-slim

WORKDIR /app

# Increase pip timeout to handle slow networks
COPY requirements-streamlit.txt .
RUN pip install --no-cache-dir --timeout=120 -r requirements-streamlit.txt

COPY app/ ./

CMD ["streamlit", "run", "streamlit_app.py", \
     "--server.port=8501", "--server.address=0.0.0.0"]
